# Copy to .env and adjust. NEVER commit .env.
#
# The same variable names are used locally (Docker Compose) and in Azure
# (Container Apps environment variables / secrets). Only the values change.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulseops
POSTGRES_USER=pulseops
POSTGRES_PASSWORD=pulseops

# --- Kafka --------------------------------------------------------------
# Local (apps on the host):      localhost:9092
# Local (apps inside Compose):   kafka:9092
# Azure:                         <managed-kafka-endpoint>:9093
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- LLM ----------------------------------------------------------------
# NEVER put a real key in this file. It is a committed template.
# Real values belong in .env, which is gitignored.
#
# Leave LLM_API_KEY empty to run with the built-in rule-based provider, which
# produces a deterministic RCA from the evidence package without a network call.
#
# Azure OpenAI: LLM_BASE_URL must end in /openai/v1 and LLM_MODEL is the
# DEPLOYMENT name, not the model name.
#   LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
#   LLM_MODEL=<your-deployment-name>
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
# bearer (OpenAI and Azure v1) or api-key (Azure REST style)
LLM_AUTH_HEADER=bearer
# Reasoning models are slow: a full-evidence RCA was measured at ~57s.
LLM_TIMEOUT_SECONDS=120

# --- ShopFlow -----------------------------------------------------------
SHOPFLOW_PAYMENT_BASE_URL=http://localhost:8083
PULSEOPS_INGEST_BASE_URL=http://localhost:8081
