# Rendered by the nginx image's envsubst at container start, so API_UPSTREAM can differ per
# environment without rebuilding the image.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Keeps the browser on one origin, which is why the app needs no CORS configuration.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The RCA endpoint is polled, not long-lived, but an investigation can still be slow.
        proxy_read_timeout 60s;
    }

    location /actuator/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
    }

    # Hashed build artefacts are immutable; index.html and config.js must never be cached, or a
    # deployed change stays invisible until the browser happens to revalidate.
    location ~* \.(js|css|woff2?|png|jpe?g|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /config.js {
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Single-page app: unknown paths return index.html so a refresh on /incidents/{key} works.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
